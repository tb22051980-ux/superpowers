{
  "name": "rennlinie-desktop",
  "productName": "Rennlinie",
  "version": "1.0.0",
  "description": "Rennlinie als Windows-Programm (Electron)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-packager . Rennlinie --platform=win32 --arch=x64 --out=dist --overwrite --asar --ignore=\"^/dist\" --ignore=\"^/node_modules/\\.cache\"",
    "build:linux": "electron-packager . Rennlinie --platform=linux --arch=x64 --out=dist --overwrite --asar --ignore=\"^/dist\"",
    "build:mac": "electron-packager . Rennlinie --platform=darwin --arch=arm64 --out=dist --overwrite --asar --ignore=\"^/dist\""
  },
  "devDependencies": {
    "electron": "44.3.0",
    "@electron/packager": "18.3.6"
  }
}
